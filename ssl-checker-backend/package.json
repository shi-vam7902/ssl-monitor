{
  "name": "ssl-checker-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env NODE_ENV=production nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:stage": "cross-env NODE_ENV=staging nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "deploy:dev": "pm2 startOrRestart ecosystem.config.js --only ssl-monitor-backend-dev",
    "deploy:stage": "pm2 startOrRestart ecosystem.config.js --only ssl-monitor-backend-stage",
    "deploy:prod": "pm2 startOrRestart ecosystem.config.js --only ssl-monitor-backend-prod"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.609.0",
