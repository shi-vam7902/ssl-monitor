    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.17",
    "@nestjs/platform-socket.io": "^10.4.19",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/mongoose": "^10.0.10",
    "mongoose": "^8.8.4",
    "mongoose-paginate-v2": "^1.8.5",
    "@nestjs/websockets": "^10.4.19",
    "@types/ssh2": "^1.15.5",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cron": "^3.1.7",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "jimp": "^1.6.0",
    "moment": "^2.30.1",
    "nest-winston": "^1.10.0",
    "node-ssh": "^13.2.1",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "ssl-checker": "^2.0.7",
    "qrcode": "^1.5.4",
