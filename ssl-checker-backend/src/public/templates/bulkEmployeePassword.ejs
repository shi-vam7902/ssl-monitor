<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Employee Onboarding Email</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f5f7fa;
            margin: 0;
            padding: 20px;
            line-height: 1.6;
        }

        .preview-container {
            max-width: 800px;
            margin: 0 auto;
        }

        h1 {
            text-align: center;
            color: #2d3748;
            margin-bottom: 40px;
            font-weight: 600;
        }

        .template-section {
            background: white;
            border-radius: 12px;
            margin-bottom: 30px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }

        .section-header {
            background: #4a5568;
            color: white;
            padding: 15px 25px;
            font-weight: 600;
            font-size: 16px;
        }

        .success-header {
            background: #3182ce;
        }

        .email-template {
            max-width: 600px;
            margin: 0 auto;
            background: #ffffff;
            color: #2d3748;
        }

        .email-header {
            text-align: center;
            padding: 30px 20px 20px;
            border-bottom: 1px solid #e2e8f0;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;
            color: #2b6cb0;
            margin-bottom: 5px;
        }

        .email-body {
            padding: 30px 25px;
        }

        .subject-line {
            font-size: 22px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #2d3748;
        }

        .greeting {
            font-size: 16px;
            margin-bottom: 20px;
            color: #4a5568;
        }

        .message {
            font-size: 15px;
            margin-bottom: 20px;
            color: #4a5568;
        }

        .custom-message {
            background: #f7fafc;
            border-left: 4px solid #3182ce;
            padding: 15px;
            border-radius: 6px;
            color: #2d3748;
        }

        .org-info {
            background: #f7fafc;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            padding: 15px;
            margin: 20px 0;
        }

        .org-label {
            font-size: 13px;
            color: #718096;
            font-weight: 500;
            margin-bottom: 5px;
        }

        .org-id {
            font-size: 16px;
            font-weight: 600;
            color: #2d3748;
            font-family: 'Courier New', monospace;
        }

        .button {
            display: inline-block;
            padding: 12px 24px;
            background: #3182ce;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 500;
            margin: 20px 0;
            transition: background-color 0.2s;
        }

        .button:hover {
            background: #2c5282;
        }

        .note {
            font-size: 13px;
            color: #718096;
            margin-top: 25px;
            padding-top: 15px;
            border-top: 1px solid #e2e8f0;
        }

        .footer {
            text-align: center;
            padding: 20px;
            background: #f7fafc;
            border-top: 1px solid #e2e8f0;
            font-size: 12px;
            color: #a0aec0;
        }

        @media (max-width: 600px) {
            .email-body {
                padding: 25px 20px;
            }

            .subject-line {
                font-size: 20px;
            }

            .button {
                display: block;
                text-align: center;
                margin: 20px auto;
            }
        }

        .template-wrapper {
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            margin: 20px;
            background: white;
        }
    </style>
</head>

<body>
    <div class="preview-container">
        <h1>📧 Employee Onboarding Email</h1>

        <div class="template-section">
            <div class="section-header success-header">
                👤 Set Password for Your New Employee Account
            </div>

            <div class="template-wrapper">
                <div class="email-template">
                    <div class="email-header">
                        <div class="logo">
                            <%= companyName %>
                        </div>
                    </div>

                    <div class="email-body">
                        <h2 class="subject-line">Welcome Aboard!</h2>
                        <p class="greeting">Hi <%= firstName + ' ' + lastName %>,</p>

                        <p class="message">
                            You have been successfully added as an employee to <strong>
                                <%= companyName %>
                            </strong>.
                            To access your account, please set your password using the link below.
                        </p>

                        <div class="org-info">
                            <div class="org-label">Organization ID</div>
                            <div class="org-id">
                                <%= organizationId %>
                            </div>
                        </div>

                        <p class="message">
                            Click the button below to create your password and get started:
                        </p>

                        <a href="<%= resetLink %>" class="button">Set Your Password</a>

                        <% if (mailMessage && mailMessage.trim() !=='' ) { %>
                            <div class="custom-message">
                                <strong>Message from your organization:</strong><br>
                                <%= mailMessage %>
                            </div>
                            <% } %>

                                <div class="note">
                                    This link will expire in 24 hours. If you did not expect this email, you can safely
                                    ignore it.
                                </div>
                    </div>

                    <div class="footer">
                        © <%= year %>
                            <%= companyName %>. All rights reserved.<br />
                                Need help? Contact <a
                                    href="mailto:monitorserver@yourcompany.com">support@yourcompany.com</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>